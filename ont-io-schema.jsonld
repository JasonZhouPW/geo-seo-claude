  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Ontology (ONT)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ontology is a Layer 1 blockchain infrastructure that provides decentralized identity (DID), reputation, and communication tools for Web3. It enables users and developers to manage digital identity, reputation, and communication with privacy, trust, and control at the core."
        }
      },
      {
        "@type": "Question",
        "name": "What is ONT ID?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ONT ID is Ontology's self-sovereign identity solution that gives users full control over their digital identity and personal data. It enables privacy-preserving authentication and selective disclosure of credentials."
        }
      },
      {
        "@type": "Question",
        "name": "How do I stake ONT tokens?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can stake ONT tokens by running a node or using liquid staking through node.ont.io. Staking helps secure the network and earns rewards for participants."
        }
      },
      {
        "@type": "Question",
        "name": "What is the ONT Token used for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ONT is the native utility token of the Ontology blockchain. It is used for governance voting, network fee payment, staking for node operation, and ecosystem incentives."
        }
      },
      {
        "@type": "Question",
        "name": "What is the Ontology DID Fund?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The $10M Ontology DID Fund supports developers and projects building decentralized identity solutions on the Ontology blockchain. Available at ont.id/did_fund."
        }
      }
    ]
  }
]
